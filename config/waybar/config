{
    "layer": "top",
    "modules-left": ["custom/silentmode", "keyboard-state", "mpd"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["tray", "backlight", "pulseaudio", "battery", "network", "clock"],

    "keyboard-state": {
        "capslock": true,
        "format": {
            "capslock": "{icon}"
        },
        "format-icons": {
            "locked": "󰪛",
            "unlocked": ""
        }
    },
    "backlight": {
        "format-icons": ["󰃚 ", "󰃛", "󰃜", "󰃝 ", "󰃞 ", "󰃟 ", "󰃠 "],
        "format": "{icon} {percent}%"
    },
    "battery": {
        "bat": "BAT0",
        "format": "{capacity}% {icon}",
        "format-Not charging": "{capacity}% 󱉞",
        "format-icons": ["", "", "", "", ""],
    },
    "mpd": {
        "server": "localhost",
        "port": 6600,
        "format": "{stateIcon}  {title} - {artist}",
        "tooltip-format": "{title} - {artist} - {album}",
        "on-click": "mpc toggle",
        "interval": 1,
        "format-stopped": "",
        "state-icons": {
            "paused": "",
            "playing": ""
        }
    },
    "hyprland/workspaces": {
        "active-only": false,
        "format": "{icon}",
        "on-click": "activate",
        "persistent_workspaces": {
            "1": "eDP-1",
            "2": "eDP-1",
            "3": "eDP-1",
            "4": "eDP-1",
            "5": "eDP-1",
            "6": "eDP-1",
            "7": "eDP-1",
            "8": "eDP-1",
            "9": "eDP-1"
        },
        "format-icons": {
            "1": "󰲡",
            "2": "󰲣",
            "3": "󰲥",
            "4": "󰲧",
            "5": "󰲩",
            "6": "󰲫",
            "7": "󰲭",
            "8": "󰲯",
            "9": "󰲱",
            "default": "",
            "urgent": "",
        }
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ifname} ",
        "format-disconnected": "", 
        "max-length": 50
    },
    "tray": {
        "icon-size": 15,
        "spacing": 10
    },
    "clock": {
        "interval": 1,
        "format": "{:%a %b %d %r %Z}",
        "timezones": ["America/New_York", "America/Chicago"],
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "actions": {
             "on-click": "tz_down",
         }
    },
    "pulseaudio": {
        "format": "{volume}% {icon} ",
        "format-bluetooth": "{volume}% {icon}  {format_source}",
        "format-bluetooth-muted": "󰖁 {icon}  {format_source}",
        "format-muted": "0% {icon} ",
        "format-source": "{volume}%  ",
        "format-source-muted": " ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/silentmode": {
        "format": "{}",
        "exec": "[[ $(xfconf-query -c xfce4-notifyd -p /do-not-disturb) == false ]] && echo  || echo ",
        "interval": 1,
        "on-click": "${HOME}/.config/hypr/do-not-disturb.sh"
    }
}

